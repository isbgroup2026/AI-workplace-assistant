# Supabase (reuse same project as frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional fallback if service key unavailable (PoC only — prefer service key)
SUPABASE_ANON_KEY=your-anon-key

# LLM (optional — router uses deterministic rules until configured)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
